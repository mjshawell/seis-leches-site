---
import { stats } from '../data/site';
---
<section aria-label="By the numbers" class="bg-ink py-18 text-paper">
  <dl class="container-site grid grid-cols-2 gap-8 lg:grid-cols-4">
    {stats.map((s) => (
      <div class="flex flex-col-reverse">
        <dt class="mt-2 text-[15px] text-ink-muted">{s.label}</dt>
        <dd class="text-[clamp(36px,4vw,48px)] font-extrabold tracking-[-0.03em]">{s.value}</dd>
      </div>
    ))}
  </dl>
</section>
