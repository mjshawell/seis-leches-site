---
import { site, needs } from '../data/site';
const field = 'min-h-12 rounded-md border-[1.5px] border-field bg-paper px-3.5 font-normal text-ink';
---
<section id="contact" class="on-ink scroll-mt-20 bg-ink py-26 text-paper">
  <div class="container-site flex flex-wrap items-start gap-14" data-reveal-stagger>
    <div class="min-w-0 flex-[1_1_420px]">
      <p class="eyebrow mb-4 text-ink-muted">Let's talk</p>
      <h2 class="text-[clamp(34px,4.2vw,56px)] font-extrabold leading-[1.05] tracking-[-0.035em]">
        Find out what your marketing is actually doing.
      </h2>
      <p class="mt-6 max-w-[460px] text-[17px] leading-relaxed text-ink-body">
        Book a free 30-minute strategy call. You'll leave with three quick wins, whether or not we work together.
      </p>
      <p class="mt-8 text-[15px] text-ink-body">
        Or email <a href={`mailto:${site.email}`} class="font-bold text-paper underline underline-offset-4">{site.email}</a>
      </p>
    </div>

    <!--
      Netlify Forms stores each submission and filters spam. A Netlify outgoing webhook then
      sends it to the Google Apps Script in integrations/google-sheets, which adds a row to
      the "Inbound" tab of the Seis Leches Lead Tracker and emails an alert.
    -->
    <form
      name="strategy-call"
      method="POST"
      action="/thanks"
      data-netlify="true"
      netlify-honeypot="company-url"
      data-lead-form
      class="flex min-w-0 flex-[1_1_420px] flex-col gap-4.5 rounded-xl bg-paper p-6 text-ink sm:p-8 [&_:focus-visible]:outline-ink"
    >
      <input type="hidden" name="form-name" value="strategy-call" />
      <p class="hidden"><label>Leave this empty <input name="company-url" /></label></p>
      <!-- Attribution, filled in by the script below -->
      <input type="hidden" name="source_page" value="" />
      <input type="hidden" name="referrer" value="" />
      <input type="hidden" name="utm_source" value="" />
      <input type="hidden" name="utm_medium" value="" />
      <input type="hidden" name="utm_campaign" value="" />
      <div class="flex flex-wrap gap-4.5">
        <label class="flex flex-[1_1_180px] flex-col gap-2 text-sm font-semibold">Name
          <input class={field} type="text" name="name" autocomplete="name" required placeholder="Jane Rivera" />
        </label>
        <label class="flex flex-[1_1_180px] flex-col gap-2 text-sm font-semibold">Work email
          <input class={field} type="email" name="email" autocomplete="email" required placeholder="jane@company.com" />
        </label>
      </div>
      <label class="flex flex-col gap-2 text-sm font-semibold">Company
        <input class={field} type="text" name="company" autocomplete="organization" placeholder="Company name" />
      </label>
      <label class="flex flex-col gap-2 text-sm font-semibold">What do you need most?
        <select class={field} name="need">
          {needs.map((n) => <option>{n}</option>)}
        </select>
      </label>
      <button type="submit" class="btn-primary mt-1.5 w-full cursor-pointer">Book my strategy call</button>
    </form>
  </div>
</section>

<script>
  // Lead attribution. The first page a visitor lands on in a session carries the UTM tags
  // and the outside referrer, so keep those until they submit, even after they click around.
  const KEY = 'sl-attribution';
  const params = new URLSearchParams(location.search);
  const fromUrl = {
    utm_source: params.get('utm_source') ?? '',
    utm_medium: params.get('utm_medium') ?? '',
    utm_campaign: params.get('utm_campaign') ?? '',
  };
  const externalReferrer = document.referrer && new URL(document.referrer).host !== location.host ? document.referrer : '';

  let saved: Record<string, string> = {};
  try { saved = JSON.parse(sessionStorage.getItem(KEY) ?? '{}'); } catch {}
  if (fromUrl.utm_source || !saved.landing_page) {
    saved = { ...fromUrl, referrer: externalReferrer || saved.referrer || '', landing_page: location.pathname };
    try { sessionStorage.setItem(KEY, JSON.stringify(saved)); } catch {}
  }

  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    const set = (name: string, value: string) => {
      const input = form.querySelector<HTMLInputElement>(`input[name="${name}"]`);
      if (input) input.value = value;
    };
    set('source_page', saved.landing_page || location.pathname);
    set('referrer', saved.referrer || '(direct)');
    set('utm_source', saved.utm_source ?? '');
    set('utm_medium', saved.utm_medium ?? '');
    set('utm_campaign', saved.utm_campaign ?? '');
  });
</script>
