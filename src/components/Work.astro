---
import { caseStudies } from '../data/site';
const { feature, side } = caseStudies;
---
<section id="work" class="container-site scroll-mt-20 pb-24 pt-28">
  <div class="mb-12 flex flex-wrap items-end justify-between gap-6" data-reveal-stagger>
    <div>
      <p class="eyebrow mb-4">Selected work</p>
      <h2 class="heading-section">Results, with receipts.</h2>
    </div>
    <a href="#" class="inline-flex min-h-11 items-center font-bold hover:underline underline-offset-4">View all case studies →</a>
  </div>

  <div class="flex flex-wrap gap-6" data-reveal-stagger>
    <article class="flex min-w-0 flex-[2_1_560px] flex-col overflow-hidden rounded-lg border-[1.5px] border-ink">
      <div class="ph h-[320px] border-0 border-b" role="img" aria-label="Placeholder for case study image"></div>
      <div class="flex flex-wrap items-end justify-between gap-6 p-8">
        <div class="flex-[1_1_280px]">
          <p class="eyebrow mb-2 tracking-[0.08em]">{feature.tag}</p>
          <h3 class="text-[26px] font-bold leading-snug tracking-[-0.02em]">{feature.title}</h3>
        </div>
        <div class="text-right">
          <p class="text-5xl font-extrabold leading-none tracking-[-0.03em]">{feature.stat}</p>
          <p class="mt-1.5 text-sm text-muted">{feature.statLabel}</p>
        </div>
      </div>
    </article>

    <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-6">
      {side.map((c) => (
        <article class="flex flex-1 flex-col gap-3 rounded-lg border-[1.5px] border-ink p-7">
          <p class="eyebrow tracking-[0.08em]">{c.tag}</p>
          <h3 class="text-[21px] font-bold leading-snug">{c.title}</h3>
          <p class="mt-auto pt-4 text-4xl font-extrabold tracking-[-0.03em]">{c.stat}</p>
        </article>
      ))}
    </div>
  </div>
</section>
