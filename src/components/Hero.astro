---
import { site } from '../data/site';
---
<section id="top" class="container-site flex flex-wrap items-center gap-14 pb-20 pt-16 md:pt-24">
  <div class="min-w-0 flex-[1_1_540px]" data-reveal-stagger>
    <p class="eyebrow mb-5">Full-funnel marketing agency · {site.location}</p>
    <h1 class="text-balance font-display text-[clamp(42px,5.6vw,76px)] font-extrabold leading-[1.02] tracking-[-0.035em]">
      {site.tagline}
    </h1>
    <p class="mt-7 max-w-[540px] text-[19px] leading-relaxed text-body">
      Six marketers, one recipe. We pair brand and social craft with paid media and analytics automation, so every campaign ships with the numbers to back it.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="#contact" class="btn-primary">Book a strategy call</a>
      <a href="#work" class="btn-secondary">See our work</a>
    </div>
    <p class="mt-6 text-sm text-muted">Free 30-minute call · Leave with three quick wins</p>
  </div>
  <div class="min-w-0 flex-[1_1_400px]" data-reveal style="--reveal-delay: 200ms">
    <div class="ph flex aspect-[5/4] items-center justify-center rounded-lg" role="img" aria-label="Placeholder for hero image or short reel">
      <span class="rounded bg-paper px-3 py-1.5 text-[13px] font-semibold text-body">Hero image or short reel</span>
    </div>
  </div>
</section>
