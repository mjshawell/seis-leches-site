---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Thanks | Seis Leches">
  <meta name="robots" content="noindex" slot="head" />
  <Header />
  <main id="main" class="container-site py-32 text-center">
    <p class="eyebrow mb-4">Request received</p>
    <h1 class="heading-section">Thanks. We'll be in touch within one business day.</h1>
    <p class="mx-auto mt-5 max-w-[520px] text-[17px] leading-relaxed text-body">In the meantime, take a look at how we work with clients like you.</p>
    <a href="/#work" class="btn-secondary mt-9">See our work</a>
  </main>
  <Footer />
</Base>
