---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

// Same link as "Booking link" in the lead tracker's Team & Settings tab.
const booking = site.bookingUrl?.trim() ?? '';
let embedSrc = '';
if (booking) {
  const url = new URL(booking);
  if (url.hostname.endsWith('calendar.google.com')) url.searchParams.set('gv', 'true'); // Google appointment schedule
  if (url.hostname.endsWith('calendly.com')) url.searchParams.set('hide_gdpr_banner', '1');
  embedSrc = url.toString();
}
---
<Base title="Thanks | Seis Leches" noindex>
  <Header />
  <main id="main" class="container-site py-20 md:py-28">
    <div class="mx-auto max-w-[680px] text-center">
      <p class="eyebrow mb-4">Request received</p>
      {booking ? (
        <h1 class="heading-section">Thanks. Grab a time for your strategy call.</h1>
      ) : (
        <h1 class="heading-section">Thanks. We'll be in touch within one business day.</h1>
      )}
      <p class="mx-auto mt-5 max-w-[540px] text-[17px] leading-relaxed text-body">
        {booking
          ? "Pick a slot below and you're set. We've also emailed you a confirmation with this link, so you can book later."
          : "Check your inbox for a confirmation. In the meantime, take a look at how we work with clients like you."}
      </p>
    </div>

    {booking ? (
      <div class="mx-auto mt-12 max-w-[960px]">
        <div class="overflow-hidden rounded-xl border border-line bg-paper">
          <iframe
            src={embedSrc}
            title="Book your strategy call"
            class="block h-[720px] w-full border-0"
            loading="lazy"
          ></iframe>
        </div>
        <p class="mt-4 text-center text-sm text-muted">
          Calendar not loading? <a href={booking} target="_blank" rel="noopener" class="font-semibold text-ink underline underline-offset-4">Open it in a new tab</a>.
        </p>
      </div>
    ) : (
      <div class="mt-9 text-center">
        <a href="/#work" class="btn-secondary">See our work</a>
      </div>
    )}
  </main>
  <Footer />
</Base>
